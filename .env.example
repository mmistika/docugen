# Spring Configuration
SPRING_PROFILES_ACTIVE=prod
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://your-auth0-domain.auth0.com/
SPRING_SECURITY_OAUTH2.RESOURCESERVER_JWT_AUDIENCES=your-api-audience
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Connection (Spring API)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/your_database_name
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password

# Database Credentials (PostgreSQL Container)
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=your_database_name

# Frontend Build Arguments (Docker)
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_API_URL=http://localhost:8080/api
